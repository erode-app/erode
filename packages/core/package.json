{
  "name": "@erode-app/core",
  "version": "0.0.1",
  "description": "Architecture erosion detection",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "erode-ci": "./dist/ci-entry.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "check:ci": "concurrently --group \"npm:lint\" \"npm:typecheck\" \"npm:format:check\" \"npm:check:schema\"",
    "check:schema": "tsx scripts/generate-schema.ts --check",
    "build": "tsc && npm run copy-assets",
    "copy-assets": "bash scripts/copy-assets.sh",
    "dev": "tsx watch src/ci-entry.ts",
    "start": "node dist/ci-entry.js",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --report-unused-disable-directives --max-warnings 0 --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate:schema": "tsx scripts/generate-schema.ts"
  },
  "keywords": [
    "architecture",
    "erode",
    "c4-model"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/erode-app/erode.git",
    "directory": "packages/core"
  },
  "author": "Anders Hassis",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@gitbeaker/rest": "^43.8.0",
    "@google/genai": "^2.16.0",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^17.4.2",
    "likec4": "^1.59.2",
    "minimatch": "^10.2.6",
    "openai": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@erode-app/eslint-config": "*",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
